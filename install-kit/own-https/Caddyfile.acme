# PREPARATION ONLY / UNADVERTISED until issuance, renewal and egress receipts.
# IT supplies a stable hostname and signed release ACME endpoint configuration.
# Run only on a network whose firewall permits that CA and its DNS resolver.
# Never attach this profile's outbound network to the gateway.
{
    admin off
    http_port 8081
    https_port 8443
}
{$DOOR_HOSTNAME} {
    tls {
        ca {$ACME_DIRECTORY}
        issuer acme {
            disable_http_challenge
        }
    }
    header Cache-Control "no-store"
    header Referrer-Policy "no-referrer"
    reverse_proxy 172.30.196.2:8080
}
